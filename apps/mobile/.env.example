# No credentials are required to browse the bundled dictionary.
# Configure your Worker HTTPS URL and personal access token inside the app.
# Never place Cloudflare account API credentials in EXPO_PUBLIC_* values.

# Optional: a unique iOS bundle ID for your Xcode Personal Team.
# OPENROOTS_IOS_BUNDLE_ID=org.openroots.yourname

# Optional, eligible Apple teams only; leave disabled for free Personal Team signing.
# OPENROOTS_EXTENDED_MEMORY=1
