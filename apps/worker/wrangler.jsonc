{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openroots-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": false },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  "observability": { "enabled": false }
}
